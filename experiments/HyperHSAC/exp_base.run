#!/bin/bash
#SBATCH --nodes 1
#SBATCH --ntasks 1
#SBATCH --cpus-per-task 8
#SBATCH --partition l40s
#SBATCH --gpus 1
#SBATCH --time 24:00:00

# Example SLURM script. Adjust the partition/module/env activation for your site.
# Submit from the repository root, e.g.:  sbatch experiments/HyperHSAC/exp_base.run
module load gurobi
cd "${SLURM_SUBMIT_DIR:-$(pwd)}"

python experiments/HyperHSAC/run_exp_base.py
